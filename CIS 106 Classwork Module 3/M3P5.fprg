<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="M3P5"/>
        <attribute name="authors" value="shama"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-07 04:35:55 PM"/>
        <attribute name="created" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMDc7MDQ6MjY6MTIgUE07MjkyOA=="/>
        <attribute name="edited" value="c2hhbWE7REVTS1RPUC1HSFRTUVVGOzIwMjYtMTAtMDc7MDQ6MzU6NTUgUE07MTszMDQz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="radius" type="Real" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <declare name="perimeter" type="Real" array="False" size=""/>
            <input variable="radius"/>
            <assign variable="area" expression="pi*radius*radius"/>
            <assign variable="perimeter" expression="2*pi*radius"/>
            <output expression="&quot;Area: &quot; &amp; area" newline="True"/>
            <output expression="&quot;Perimeter: &quot; &amp; perimeter" newline="True"/>
        </body>
    </function>
</flowgorithm>
